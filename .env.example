# Copie para .env e ajuste. Todas as variaveis estao documentadas em
# docs/configuracao.md. Nada aqui e obrigatorio -- os padroes funcionam.

# --- Perfil: desenvolvimento sem nenhum hardware ---
AVS_VISION__BACKEND=auto
AVS_AUDIO__SINKS=["dashboard","host"]
AVS_STORAGE__LOG_EVENTS=true

# --- Modelo ---
# Padrao "auto": yolo11s.pt em CPU, yolo11l.pt quando ha GPU CUDA. Comparativo de
# tempo por quadro e acuracia em docs/configuracao.md.
# AVS_VISION__MODEL_PATH=yolo11n.pt       # maquina fraca
# AVS_VISION__MODEL_PATH=models/best.pt   # pesos refinados por training/train.py
# AVS_VISION__DEVICE=cuda
# AVS_VISION__CONFIDENCE_THRESHOLD=0.50
# AVS_VISION__INFERENCE_SIZE=640

# Realce de contraste: ajuda em pouca luz, atrapalha com iluminacao boa.
# AVS_PREPROCESS__CLAHE=false
# Rotacao do quadro, se a camera estiver montada invertida (0/90/180/270)
# AVS_PREPROCESS__ROTATE_DEG=180

# --- Zonas de proximidade (espelham firmware/esp32cam/include/config.h) ---
# AVS_PROXIMITY__WARNING_DISTANCE_M=1.50
# AVS_PROXIMITY__CRITICAL_DISTANCE_M=0.80

# --- Narracao: aumente os cooldowns se o usuario achar o sistema falante ---
# AVS_NARRATION__OBJECT_COOLDOWN_MS=6000
# AVS_NARRATION__MAX_OBJECTS_PER_UTTERANCE=3

# --- Quando o alto-falante do prototipo estiver montado ---
# AVS_AUDIO__SINKS=["device","dashboard"]

# --- Quando o microfone estiver montado ---
# AVS_SPEECH__STT_ENGINE=whisper
# AVS_SPEECH__SOURCE=device

# --- Seguranca: defina o mesmo valor em firmware/esp32cam/include/secrets.h ---
# AVS_SERVER__DEVICE_TOKEN=troque-este-valor

# --- Filtro de falso positivo ---
# Quadros consecutivos com o mesmo rotulo antes de o objeto virar fala.
# AVS_TRACKING__MIN_HITS=4
